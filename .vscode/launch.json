{
  "version": "0.2.0",
  "configurations": [
    {
      // Vite dev server on http://localhost:3303: reloads on every save of src/ or data/.
      // Google Drive sync works here too (same /api/google endpoints as the server).
      "name": "Dev server (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/web",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://127\\.0\\.0\\.1:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      // Builds the app, then runs web/server/serve.ts on http://localhost:3303, like start.sh.
      // The Stop button stops the server.
      "name": "Build and run (localhost:3303)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx vite build --logLevel warn && node server/serve.ts",
      "cwd": "${workspaceFolder}/web",
      "serverReadyAction": {
        // Also matches "Port 3303 is already in use", so the browser still opens
        // when start.sh is already running the server.
        "pattern": "(?:App running at http://localhost:|Port )(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
