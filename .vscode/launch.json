{
  "version": "0.2.0",
  "configurations": [
    {
      // Opens web/index.html straight from disk: no server, no Google Drive sync.
      // The first time, the page asks you to pick the web/data folder.
      "name": "Open index.html (no server)",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/web/index.html"
    },
    {
      // Runs web/server.js on http://localhost:8080 (needed for Google Drive sync)
      // and opens it in the default browser. The Stop button stops the server.
      "name": "Run server (localhost:8080)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/web/server.js",
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "serverReadyAction": {
        // Also matches "Port 8080 is already in use", so the browser still opens
        // when start.sh is already running the server.
        "pattern": "(?:App running at http://localhost:|Port )(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
