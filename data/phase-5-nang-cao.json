      "template": [
        {
          "lang": "python",
          "code": {
            "vi": [
              "def prefix_function(s):",
              "    # pi[i] = độ dài tiền tố dài nhất của s[0..i] đồng thời là hậu tố",
              "    pi = [0] * len(s)",
              "    for i in range(1, len(s)):",
              "        j = pi[i - 1]",
              "        while j and s[i] != s[j]:",
              "            j = pi[j - 1]",
              "        if s[i] == s[j]:",
              "            j += 1",
              "        pi[i] = j",
              "    return pi",
              "",
              "def find_all(text, pattern):       # mọi vị trí pattern xuất hiện, O(n + m)",
              "    s = pattern + '#' + text       # '#' không được xuất hiện trong text",
              "    pi = prefix_function(s)",
              "    m = len(pattern)",
              "    return [i - 2 * m for i in range(len(s)) if pi[i] == m]"
            ],
            "en": [
              "def prefix_function(s):",
              "    # pi[i] = length of the longest proper prefix of s[0..i] that is also its suffix",
              "    pi = [0] * len(s)",
              "    for i in range(1, len(s)):",
              "        j = pi[i - 1]",
              "        while j and s[i] != s[j]:",
              "            j = pi[j - 1]",
              "        if s[i] == s[j]:",
              "            j += 1",
              "        pi[i] = j",
              "    return pi",
              "",
              "def find_all(text, pattern):       # every index where pattern occurs, O(n + m)",
              "    s = pattern + '#' + text       # '#' must not appear in text",
              "    pi = prefix_function(s)",
              "    m = len(pattern)",
              "    return [i - 2 * m for i in range(len(s)) if pi[i] == m]"
            ]
          }
        },
        {
          "lang": "java",
          "code": {
            "vi": [
              "import java.util.*;",
              "",
              "class KMP {",
              "    // pi[i] = độ dài tiền tố dài nhất của s[0..i] đồng thời là hậu tố",
              "    static int[] prefixFunction(String s) {",
              "        int[] pi = new int[s.length()];",
              "        for (int i = 1; i < s.length(); i++) {",
              "            int j = pi[i - 1];",
              "            while (j > 0 && s.charAt(i) != s.charAt(j)) j = pi[j - 1];",
              "            if (s.charAt(i) == s.charAt(j)) j++;",
              "            pi[i] = j;",
              "        }",
              "        return pi;",
              "    }",
              "",
              "    static List<Integer> findAll(String text, String pattern) {   // mọi vị trí pattern xuất hiện, O(n + m)",
              "        String s = pattern + '#' + text;           // '#' không được xuất hiện trong text",
              "        int[] pi = prefixFunction(s);",
              "        int m = pattern.length();",
              "        List<Integer> res = new ArrayList<>();",
              "        for (int i = 0; i < s.length(); i++)",
              "            if (pi[i] == m) res.add(i - 2 * m);",
              "        return res;",
              "    }",
              "}"
            ],
            "en": [
              "import java.util.*;",
              "",
              "class KMP {",
              "    // pi[i] = length of the longest proper prefix of s[0..i] that is also its suffix",
              "    static int[] prefixFunction(String s) {",
              "        int[] pi = new int[s.length()];",
              "        for (int i = 1; i < s.length(); i++) {",
              "            int j = pi[i - 1];",
              "            while (j > 0 && s.charAt(i) != s.charAt(j)) j = pi[j - 1];",
              "            if (s.charAt(i) == s.charAt(j)) j++;",
              "            pi[i] = j;",
              "        }",
              "        return pi;",
              "    }",
              "",
              "    static List<Integer> findAll(String text, String pattern) {   // every index where pattern occurs, O(n + m)",
              "        String s = pattern + '#' + text;           // '#' must not appear in text",
              "        int[] pi = prefixFunction(s);",
              "        int m = pattern.length();",
              "        List<Integer> res = new ArrayList<>();",
              "        for (int i = 0; i < s.length(); i++)",
              "            if (pi[i] == m) res.add(i - 2 * m);",
              "        return res;",
              "    }",
              "}"
            ]
