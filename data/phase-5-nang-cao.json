        {
          "lang": "java",
          "code": {
            "vi": [
              "class Fenwick {                                    // chỉ số 1..n",
              "    private final long[] tree;",
              "",
              "    Fenwick(int n) {",
              "        tree = new long[n + 1];",
              "    }",
              "",
              "    void add(int i, long delta) {",
              "        for (; i < tree.length; i += i & -i) tree[i] += delta;",
              "    }",
              "",
              "    long prefix(int i) {                           // tổng a[1..i]",
              "        long s = 0;",
              "        for (; i > 0; i -= i & -i) s += tree[i];",
              "        return s;",
              "    }",
              "",
              "    long rangeSum(int l, int r) {",
              "        return prefix(r) - prefix(l - 1);",
              "    }",
              "}"
            ],
            "en": [
              "class Fenwick {                                    // indices 1..n",
              "    private final long[] tree;",
              "",
              "    Fenwick(int n) {",
              "        tree = new long[n + 1];",
              "    }",
              "",
              "    void add(int i, long delta) {",
              "        for (; i < tree.length; i += i & -i) tree[i] += delta;",
              "    }",
              "",
              "    long prefix(int i) {                           // sum of a[1..i]",
              "        long s = 0;",
              "        for (; i > 0; i -= i & -i) s += tree[i];",
              "        return s;",
              "    }",
              "",
              "    long rangeSum(int l, int r) {",
              "        return prefix(r) - prefix(l - 1);",
              "    }",
              "}"
