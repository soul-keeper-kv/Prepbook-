              "    Combinatorics(int n) {",
              "        fact = new long[n + 1];",
              "        inv = new long[n + 1];",
              "        fact[0] = 1;",
              "        for (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i % MOD;",
              "        inv[n] = power(fact[n], MOD - 2);          // Fermat, MOD phải là số nguyên tố",
              "        for (int i = n; i > 0; i--) inv[i - 1] = inv[i] * i % MOD;",
